<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <RuntimePackageVersion>11.0.0</RuntimePackageVersion>
        <OpenTelemetryVersion>1.21.0</OpenTelemetryVersion>
        <FusionCacheVersion>2.10.0</FusionCacheVersion>
        <TestcontainersVersion>4.17.0</TestcontainersVersion>
        <XUnitVersion>4.0.3</XUnitVersion>
        <CodeAnalysisVersion>5.12.0</CodeAnalysisVersion>
    </PropertyGroup>

    <ItemGroup>

        <!-- General Section Begin -->
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8"/>

        <PackageVersion Include="Castle.Core" Version="5.2.1"/>
        <PackageVersion Include="Castle.Core.AsyncInterceptor" Version="2.1.0"/>

        <PackageVersion Include="DistributedLock" Version="2.8.4"/>

        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0"/>
        <PackageVersion Include="MongoDB.EntityFrameworkCore" Version="10.0.6"/>
        <PackageVersion Include="MongoDB.Driver" Version="3.14.1"/>

        <PackageVersion Include="OpenTelemetry.Api" Version="$(OpenTelemetryVersion)"/>
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)"/>
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)"/>

        <PackageVersion Include="RabbitMQ.Client" Version="7.3.0"/>

        <PackageVersion Include="StackExchange.Redis" Version="3.4.35"/>

        <PackageVersion Include="ZiggyCreatures.FusionCache" Version="$(FusionCacheVersion)"/>
        <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="$(FusionCacheVersion)"/>
        <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="$(FusionCacheVersion)"/>
        <!-- General Section End -->

        <!-- Official Microsoft Section Begin -->
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(RuntimePackageVersion)"/>

        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="$(CodeAnalysisVersion)"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(CodeAnalysisVersion)"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(CodeAnalysisVersion)"/>

        <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(RuntimePackageVersion)"/>

        <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.FileProviders.Composite" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Localization" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Options" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="System.IO.Hashing" Version="$(RuntimePackageVersion)"/>
        <PackageVersion Include="System.Text.Json" Version="$(RuntimePackageVersion)"/>
        <!-- Official Microsoft Section End -->

        <!-- Test Section Begin -->
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0"/>
        <PackageVersion Include="Microsoft.Testing.Extensions.GitHubActionsReport" Version="2.5.3"/>
        <PackageVersion Include="NSubstitute" Version="6.2.0"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="Testcontainers" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.MongoDb" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.RabbitMq" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.Redis" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.PostgreSql" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="xunit.v3" Version="$(XUnitVersion)"/>
        <PackageVersion Include="xunit.v3.extensibility.core" Version="$(XUnitVersion)"/>
        <!-- Test Section End -->

    </ItemGroup>

</Project>