{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Axiom": {
    "Cache": {
      "KeyPrefix": "web-app",
      "Redis": {
        "Configuration": "localhost:6379"
      }
    },
    "EventBus": {
      "Distributed": {
        "Queue": {
          "Topology": "Single"
        },
        "RabbitMQ": {
          "ExchangeName": "web-app"
        }
      }
    },
    "RabbitMQ": {
      "Default": {
        "Hostname": "localhost",
        "Username": "guest",
        "Password": "guest"
      }
    },
    "Tenants": [
      {
        "id": "00000000-0000-0000-0000-000000000000",
        "name": "t-1",
        "normalizedName": "T-1",
        "extraProperties": {
          "key-1": 1,
          "key-2": "value"
        }
      },
      {
        "id": "00000000-0000-0000-0000-000000000001",
        "name": "t-2",
        "normalizedName": "T-2",
        "extraProperties": {
          "key-1": 2,
          "key-2": "value-2"
        }
      }
    ]
  }
}
