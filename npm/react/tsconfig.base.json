{
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "ESNEXT",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@axiomframework/react-core": ["./libs/core/src/index.ts"],
      "@axiomframework/react-theme": ["./libs/theme/src/index.ts"],
      "@axiomframework/react-theme/components": [
        "./libs/theme/src/components/index.ts"
      ]
    }
  }
}
