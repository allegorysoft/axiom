{
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "ESNEXT",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@axiomframework/react-core": ["./libs/core/src/index.ts"],
      "@axiomframework/react-shared": ["./libs/shared/src/index.ts"],
      "@axiomframework/react-oauth": ["./libs/oauth/src/index.ts"],
      "@axiomframework/react-components": ["./libs/components/src/index.ts"],
      "@axiomframework/react-account": ["./libs/account/src/index.ts"],
      "@axiomframework/react-module-1": ["./libs/module-1/src/index.ts"],
      "@axiomframework/react-module-1/config": ["./libs/module-1/src/config/index.ts"],
      "@axiomframework/react-module-2": ["./libs/module-2/src/index.ts"],
      "@axiomframework/react-theme": ["./libs/theme/src/index.ts"],
      "@axiomframework/react-theme/components": [
        "./libs/theme/src/components/index.ts"
      ]
    }
  }
}
